# --- required ---
DISCORD_TOKEN=your_bot_token_here
MEMES_CHANNEL_ID=123456789012345678
# The NAME of the custom emoji that counts toward the gate, without colons.
REQUIRED_EMOJI=your_emoji_name
REQUIRED_REACTS=3

# --- optional: each channel below switches on the feature it drives ---
# Hall of fame — memes hitting BEST_OF_REACTS get reposted here.
BEST_OF_CHANNEL_ID=
BEST_OF_REACTS=8
# Daily funniest-meme announcement.
GENERAL_CHANNEL_ID=
ANNOUNCE_HOUR=16
ANNOUNCE_MINUTE=20
ANNOUNCE_TZ=Europe/London
# Deploy changelog posted on restart when HEAD has moved.
MODS_CHANNEL_ID=

# --- optional: tuning ---
STATS_COOLDOWN_S=30
